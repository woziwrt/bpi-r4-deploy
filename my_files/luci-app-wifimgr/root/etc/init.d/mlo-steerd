#!/bin/sh /etc/rc.common

# Autostarts by default since the v0.5 rewrite (one A-TTLM per 300 s block,
# expiry doubles as the re-enable probe — the v0.4 disable/re-arm latch that
# broke SAE re-auth on MLO clients is gone). Opt out with:
#   uci set mlo-steerd.global.autostart=0 && uci commit mlo-steerd

START=95
STOP=10
USE_PROCD=1

autostart_enabled() {
    [ "$(uci -q get mlo-steerd.global.autostart)" != "0" ]
}

start_service() {
    autostart_enabled || return 0
    procd_open_instance
    procd_set_param command /bin/sh /root/mlo-steerd.sh
    procd_set_param respawn 30 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
