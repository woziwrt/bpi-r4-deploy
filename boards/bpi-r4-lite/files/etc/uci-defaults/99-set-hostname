#!/bin/sh
# /etc/uci-defaults/99-set-hostname (BPI-R4 Lite)
if grep -q 'ubi' /proc/cmdline; then
    hostname="BPI-R4-Lite-NAND"
elif [ -f /sys/firmware/devicetree/base/chosen/rootdisk-emmc ]; then
    hostname="BPI-R4-Lite-eMMC"
elif [ -f /sys/firmware/devicetree/base/chosen/rootdisk-sd ]; then
    hostname="BPI-R4-Lite-SD"
else
    hostname="BPI-R4-Lite"
fi
uci set system.@system[0].hostname="$hostname"
uci commit system
exit 0
