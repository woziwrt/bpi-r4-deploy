#!/bin/sh /etc/rc.common
#
# BPI-R4: revive copper ports whose link partner failed to renegotiate
# after a reboot (see /usr/sbin/lan-carrier-watchdogd for the full story
# and the tunables).
#
# The poll loop lives in a separate daemon file on purpose: rc.common
# wraps every invocation of an init script - extra_commands included -
# in a blocking flock on /var/lock/procd_<name>.lock, so a never-exiting
# extra_command holds the lock forever and any later start/stop/restart/
# status call deadlocks on it (bit us live 2026-07-21).

USE_PROCD=1
START=99

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/lan-carrier-watchdogd
	procd_set_param respawn 3600 30 0
	procd_close_instance
}
