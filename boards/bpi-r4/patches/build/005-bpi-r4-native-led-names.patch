# MediaTek's 999-dsa-02-add-mt7531-netlink-support.patch bundles mt7530.o
# and mt7530_nl.o into mt7530-dsa. The driver's MDIO bus ID is derived from
# KBUILD_MODNAME (hyphens become underscores), so its PHY LEDs appear as
# mt7530_dsa-0:00..03:green:* instead of upstream's mt7530-0:00..03:green:*.
# Point the R4 netdev LED defaults at those actual sysfs devices; otherwise
# OpenWrt cannot apply the link/tx/rx triggers to the native PHY LEDs.
# This is specific to the MediaTek module rename, not vanilla OpenWrt.
# It corrects newly generated defaults; preserved UCI settings need a manual
# update. Native PHY driver binding and LED registration are prerequisites.

--- a/target/linux/mediatek/filogic/base-files/etc/board.d/01_leds
+++ b/target/linux/mediatek/filogic/base-files/etc/board.d/01_leds
@@ -54,10 +54,10 @@
 bananapi,bpi-r4|\
 bananapi,bpi-r4-2g5|\
 bananapi,bpi-r4-poe)
-	ucidef_set_led_netdev "wan" "wan" "mt7530-0:00:green:wan" "wan" "link tx rx"
-	ucidef_set_led_netdev "lan1" "lan1" "mt7530-0:01:green:lan" "lan1" "link tx rx"
-	ucidef_set_led_netdev "lan2" "lan2" "mt7530-0:02:green:lan" "lan2" "link tx rx"
-	ucidef_set_led_netdev "lan3" "lan3" "mt7530-0:03:green:lan" "lan3" "link tx rx"
+	ucidef_set_led_netdev "wan" "wan" "mt7530_dsa-0:00:green:wan" "wan" "link tx rx"
+	ucidef_set_led_netdev "lan1" "lan1" "mt7530_dsa-0:01:green:lan" "lan1" "link tx rx"
+	ucidef_set_led_netdev "lan2" "lan2" "mt7530_dsa-0:02:green:lan" "lan2" "link tx rx"
+	ucidef_set_led_netdev "lan3" "lan3" "mt7530_dsa-0:03:green:lan" "lan3" "link tx rx"
 	;;
 bananapi,bpi-r4-lite)
 	ucidef_set_led_netdev "sfp0" "sfp0" "green:sfp" "sfp0" "link tx rx"
