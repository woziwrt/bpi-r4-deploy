--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4-leds.dtso
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Compatibility overlay for installed BPI-R4 boot environments.
+ *
+ * Older U-Boot environments request this overlay by name. Keep the FIT
+ * configuration available, but let each native PHY driver claim its own
+ * gbe-led pinctrl state and derive polarity from the hardware boot straps.
+ */
+/dts-v1/;
+/plugin/;
+/ {
+	compatible = "bananapi,bpi-r4", "mediatek,mt7988a";
+};
