+/* Some PHY-less copper SFP+ modules (e.g. RTL8261BE based) advertise
+ * 10GBASE-T at power-on and only switch to 1000BASE-T once they have locked
+ * a 1G link partner (or the other way round after a cable change). If the
+ * host picked its interface from the old advertisement it stays on the wrong
+ * one and the host link never comes up, although the module reports signal.
+ * T_LINK_FAIL after the module reports signal we check the host link and, if
+ * it is still down, re-read the module to pick up its current advertisement.
+ * R_REPROBE bounds the number of re-reads; the budget is renewed only after
+ * a host link has been seen.
+ */
+#define T_LINK_FAIL		msecs_to_jiffies(15000)
+#define R_REPROBE		20
