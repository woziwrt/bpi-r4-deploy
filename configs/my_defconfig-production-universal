# ═══════════════════════════════════════════════════════════════════════
# Doplneno 17. 8. 2026 — co uzivatel ceka, ze v routeru bude
#
# Kconfig pocita POSLEDNI vyskyt symbolu, takze tenhle blok prebije
# pripadne drivejsi "is not set" vyse v souboru.
# ═══════════════════════════════════════════════════════════════════════

# Externi disky. Bez techhle dvou uzivatel pripoji disk a NESTANE SE NIC —
# vetsina externich disku je exFAT nebo NTFS. Mame ksmbd na sdileni disku,
# ktery ho ale bez nich neprecte. Nejcastejsi stiznost vubec.
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

# "Nemam pevnou IP a chci se dostat domu zvenku."
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y

# Hry a konzole si samy otevrou porty. Bez toho "nejde mi multiplayer".
# Varianta -nftables, protoze obraz jede na fw4 (overeno na zeleznu 17. 8.).
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y

# "Kdo mi zere internet" — spotreba podle zarizeni.
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# Probuzeni pocitace po siti.
CONFIG_PACKAGE_luci-app-wol=y

# Blokovani reklam pro celou domacnost.
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_luci-app-adblock=y

# WireGuard: jadro uz v obrazu bylo, chybelo jen nastaveni v UI.
# V LuCI se dela jako protokol rozhrani, ne jako samostatna appka.
CONFIG_PACKAGE_luci-proto-wireguard=y

# Diagnosticke applety, ktere ve feedech nejsou — builder je kopiruje
# z my_files pred `scripts/feeds install`.
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-cpu-status=y
CONFIG_PACKAGE_luci-app-temp-status=y

# ── druha davka, 17. 8. — z Petrovy vzpominky "s cim me otravovali" ──

# macvlan na desce NEJDE: "RTNETLINK answers: Not supported" (overeno 17. 8.).
# VLAN (802.1Q) naopak funguje nativne z jadra, tam neni co pridavat.
CONFIG_PACKAGE_kmod-macvlan=y

# UAS: moderni USB3 disky bez nej spadnou na pomaly rezim.
# Projevi se jako "ten disk je nejakej pomalej", ne jako chyba.
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# Tethering z iPhonu. Android uz obraz umi (rndis + cdc-ether),
# iPhone bez techhle dvou NE — a pritom je to nejcastejsi zaloha internetu.
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_usbmuxd=y

# Uspani nepouzivaneho disku. U tocivych disku jinak hluci porad.
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_luci-app-hd-idle=y

# ── treti davka, 17. 8. — kandidati z revize balicku ──

# Tiskarna na USB routeru, sdilena do site. kmod-usb-printer je povinny:
# bez nej p910nd nema co obsluhovat a tiskarna se jen "nic nestane".
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y

# Televize vidi filmy z pripojeného disku. Dotahuje to, co uz umi ksmbd:
# disk uz jde sdilet do Windows, tohle ho zpristupni i televizi a prehravacum.
CONFIG_PACKAGE_minidlna=y
CONFIG_PACKAGE_luci-app-minidlna=y

# Vzdaleny pristup bez port forwardingu a bez verejne IP.
# Tailscale ma dnes zdaleka nejvic dotazu; zerotier je totez jinou cestou
# (v luci feedu k nemu appka NENI, nastavuje se z prikazove radky).
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_zerotier=y

# Tunely a agregace linek. Spis pro firmy, ale je to par kilobajtu
# a bez nich to proste nejde vubec.
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_ieee1905-topology-plugin=y

# scp / rsync / GUI SFTP na router (2. 9. 2026).
# Dropbear sam sftp podsystem nema, je to samostatny balicek (~30 kB).
# Novejsi scp (OpenSSH 9+) vola SFTP jako vychozi protokol, takze bez nej
# kazdy scp na router skonci na /usr/libexec/sftp-server: not found a musi
# se obchazet pres scp -O nebo rourou cat | ssh.
# Staci sem: x8 builder tenhle soubor pouziva jako _BASE a pridava jen deltu.
CONFIG_PACKAGE_openssh-sftp-server=y
