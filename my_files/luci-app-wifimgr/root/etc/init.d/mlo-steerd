#!/bin/sh /etc/rc.common

# Disabled by default: the v0.4 steering algorithm can latch a link into a
# permanent A-TTLM disable/re-arm loop (the re-enable check needs client SNR
# on the very link it disabled), and the resulting link flapping breaks SAE
# re-auth on MLO clients ("wrong password" on Android). Start it from the
# wifimgr UI, or opt in to autostart with:
#   uci set mlo-steerd.global.autostart=1 && uci commit mlo-steerd

START=95
STOP=10
USE_PROCD=1

autostart_enabled() {
    [ "$(uci -q get mlo-steerd.global.autostart)" = "1" ]
}

start_service() {
    autostart_enabled || return 0
    procd_open_instance
    procd_set_param command /bin/sh /root/mlo-steerd.sh
    procd_set_param respawn 30 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
